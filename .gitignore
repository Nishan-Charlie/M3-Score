# ─── Datasets and model weights (large, externally downloadable) ───
/data_mri/
/datasets/
/pretrained/
/checkpoints/
/test_checkpoints_unet/
/huggingface_models/
# generated sample sets — regenerate with generate.py (seeded)
/output/

# ─── Regenerable experiment caches ───
# pert_*/ are perturbed-image caches reused across runs (see experiments/noise_robustness.py).
# They hold no results of record — every number lives in the sibling *_report.json.
**/pert_*/
**/calibration_sanity/
**/_tmp_*.png
*_cache.npz
tstr_results.json

# Local Claude Code permissions — personal, not project config
.claude/settings.local.json

# ─── Manuscript and internal notes (NOT part of the code release) ───
# The paper is under review; these are deliberately excluded from the public
# repository. They remain on disk and are simply untracked.
#
# WARNING: .gitignore has NO effect on files git is already tracking. If any of
# these reappear in `git ls-files`, a `git add -f` or a re-add after a reset has
# re-tracked them; run `git rm -r --cached <path>` and commit, or they will keep
# showing up on the remote.
paper/
CITATION.cff               # cites the unpublished manuscript; restore on acceptance
CLAUDE.md                  # AI-assistant guide for this repo, internal
docs/                      # EXPERIMENT_FINDINGS, METHODOLOGY_AND_DIRECTION, next_note, specs
.claude/                   # local tooling config
# figures/ is intentionally NOT ignored -- kept in the code release.

# ─── Cleanup quarantine (delete once verified) ───
_quarantine_*/

# ─── Logging ───
/logs/
*.log
nohup.out
*.nohup.out

# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
venv/
.venv
env/
.env
.gradio
.cache/

# ─── IDEs / OS ───
.vscode/
.idea/
.DS_Store

# ─── LaTeX build byproducts ───
# NOTE: *.pdf and *.bbl are deliberately NOT ignored — paper/paper.pdf is the
# compiled manuscript and paper/Images/M3Score-Calculation.pdf is a figure the
# paper needs to compile. paper.bbl is required for arXiv submission.
*.aux
*.blg
*.fdb_latexmk
*.fls
*.toc
*.out
*.synctex.gz
*.drawio.bkp
.$*.drawio.bkp

# ─── Archives ───
*.zip
*.tar.gz